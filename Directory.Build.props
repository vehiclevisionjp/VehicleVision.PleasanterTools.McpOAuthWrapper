<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .editorconfig の IDE 規則（{} の省略禁止など）を、ビルドで強制する -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <VersionPrefix>0.3.3</VersionPrefix>
    <Company>PMC Co., Ltd. IT Solution Div.</Company>
    <Authors>PMC Co., Ltd. IT Solution Div.</Authors>
    <Copyright>Copyright (C) PMC Co., Ltd. IT Solution Div.</Copyright>
    <!-- デュアルライセンス（AGPL-3.0-or-later OR 商用）。LICENSING.md を参照。
         NuGet の PackageLicenseExpression は LicenseRef-* を含む式を受け付けないため、式は持たない -->
    <RepositoryUrl>https://github.com/vehiclevisionjp/VehicleVision.PleasanterTools.McpOAuthWrapper</RepositoryUrl>
  </PropertyGroup>
</Project>
